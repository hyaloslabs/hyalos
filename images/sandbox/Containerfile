# The sandbox image (ADR-0016, ADR-0040): the four pinned harnesses, the forwarder and the submit
# helper. Build from the repository root:
#
#   docker build -f images/sandbox/Containerfile --target sandbox -t hyalos-sandbox:latest .
#
# The `sandbox` target is the image jobs run in. The `test` target adds what the image test needs
# (curl, hyalos-dns-log, the test CA and the SDK scripts). It is the last stage, so a build that
# names no target builds it: always name one. Network is used while building, never while a job runs.

# ---- the sandbox's own programs, built from this workspace ------------------------------------
FROM rust:1.99.1-slim-bookworm@sha256:ed2c95ca377d6571b124b05e75e01207973ded639dce7d5542eb7bcd797e32aa AS tools
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml clippy.toml ./
COPY .cargo .cargo
COPY core core
COPY crates crates
RUN cargo build --release --locked -p hyalos-sandbox-tools

# ---- the image jobs run in -------------------------------------------------------------------
# Debian bookworm, the same C library the tools were built against.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS sandbox

# git, for the git proxy (ADR-0046, ADR-0049). From one Debian snapshot of the three suites the base
# image uses, so every build installs the same versions and they match the base image's packages
# (perl-base, for one, comes from bookworm-security). The proxy variables are set below, after this.
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20261027T000000Z\nSuites: bookworm bookworm-updates\nComponents: main\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/20261027T000000Z\nSuites: bookworm-security\nComponents: main\n' \
        > /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 -o Acquire::Check-Valid-Until=false update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY images/sandbox/etc/git/gitconfig /etc/gitconfig

# The harnesses and SDKs, pinned exactly with every dependency in the lockfile.
WORKDIR /opt/hyalos/harness
COPY images/sandbox/harness/package.json images/sandbox/harness/package-lock.json ./
# npm installs the musl builds next to the glibc ones; this image is glibc, so they are dead weight.
RUN npm ci --omit=dev --no-audit --no-fund \
 && rm -rf node_modules/@anthropic-ai/*-musl \
 && npm cache clean --force

COPY --from=tools /src/target/release/hyalos-forward /src/target/release/hyalos-submit /src/target/release/hyalos-pr /src/target/release/hyalos-handle /usr/local/bin/
COPY images/sandbox/etc/codex/config.toml /etc/hyalos/codex/config.toml
COPY images/sandbox/etc/claude-code/managed-settings.json /etc/claude-code/managed-settings.json
# Where a job's skills are mounted read-only (ADR-0089); empty in the image.
RUN mkdir -p /opt/hyalos/skills

# Every setting ADR-0016 lists, so a harness started here makes no call but its model's.
# The keys are placeholders: the broker drops them and adds the real one. $HOME and $CODEX_HOME
# are on the sandbox's empty /tmp, and hyalos-forward makes them before the harness starts.
ENV PATH=/opt/hyalos/harness/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/tmp/home \
    CODEX_HOME=/tmp/codex \
    ANTHROPIC_BASE_URL=http://127.0.0.1:8089 \
    ANTHROPIC_API_KEY=placeholder-not-a-key \
    OPENAI_BASE_URL=http://127.0.0.1:8089/v1 \
    OPENAI_API_KEY=placeholder-not-a-key \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    OPENAI_AGENTS_DISABLE_TRACING=1 \
    HTTPS_PROXY=http://127.0.0.1:8089 \
    HTTP_PROXY=http://127.0.0.1:8089 \
    https_proxy=http://127.0.0.1:8089 \
    http_proxy=http://127.0.0.1:8089 \
    NO_PROXY=127.0.0.1,localhost \
    no_proxy=127.0.0.1,localhost \
    GIT_TERMINAL_PROMPT=0 \
    GIT_ASKPASS=

WORKDIR /tmp
# Substrates set the program as the entrypoint (ADR-0032), so jobs run `hyalos-forward <harness> ...`.
ENTRYPOINT ["/usr/local/bin/hyalos-forward"]

# ---- the image test's additions ----------------------------------------------------------------
FROM sandbox AS test
# curl, for a harness's shell command in the egress test (ADR-0042). From the Debian snapshot the base
# image was built from, so this stage installs the same version every time; the shipped image has none.
# The image's proxy variables name the sandbox's forwarder, so apt is told to go direct.
# The snapshot source is the sandbox stage's.
RUN apt-get -o Acquire::http::Proxy=false -o Acquire::Retries=5 -o Acquire::Check-Valid-Until=false update \
    && apt-get -o Acquire::http::Proxy=false -o Acquire::Retries=5 install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=tools /src/target/release/hyalos-dns-log /usr/local/bin/
COPY images/sandbox/test/ /opt/hyalos/harness/test/
# The test authority for allowed.hyalos.test; its key was discarded when it was made.
COPY crates/sandbox-tools/tests/fixtures/tls/ca.pem /opt/hyalos/harness/test/ca.pem
