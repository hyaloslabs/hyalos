# The toolchain build.sh runs the MicroPython port's build in: clang and wasm-ld for
# wasm32-unknown-unknown, Binaryen's wasm-opt for the Asyncify pass (port/sjlj.c), and the Python and
# make that MicroPython's own build needs. The base image is pinned by digest and the compiler,
# linker and Binaryen by version; python3 and make come from the same release and are not pinned,
# since only their behaviour, not their bytes, reaches the guest.
FROM ubuntu@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      clang-18=1:18.1.3-1ubuntu1 lld-18=1:18.1.3-1ubuntu1 binaryen=108-1 python3 make \
 && rm -rf /var/lib/apt/lists/*
